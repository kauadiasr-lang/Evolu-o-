# Configuração da IA (opcional). Fica apenas no backend local (npm run ai-proxy); NUNCA vai ao navegador
# nem ao repositório (.env está no .gitignore).

# Provedor: anthropic (padrão) ou openai (qualquer API compatível: OpenAI, OpenRouter, Azure, Ollama, vLLM...)
# EVOLVERE_AI_PROVIDER=anthropic

# Chave (use a do provedor escolhido)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# EVOLVERE_AI_API_KEY=          # alternativa genérica, vale para qualquer provedor

# Opcionais
# EVOLVERE_AI_MODEL=claude-sonnet-5-5     # padrão anthropic; para openai o padrão é gpt-4o-mini
# EVOLVERE_AI_BASE_URL=                   # ex.: http://localhost:11434/v1 (Ollama); não usa ANTHROPIC_BASE_URL
# EVOLVERE_AI_RPM=12                      # limite de chamadas por minuto
